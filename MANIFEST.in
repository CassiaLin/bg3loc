# Source distribution contents.
# Keep public documentation and machine-readable contracts available when
# users install or inspect BG3Loc from the sdist rather than a Git checkout.

graft docs
graft schemas
graft examples
graft tests
graft scripts
graft tools/ci
include .github/workflows/ci.yml

# Only public source/test resources belong in distributions.
prune workspace
prune build
prune dist
prune .venv
global-exclude *.py[cod] *.pak *.loca *.sqlite *.sqlite3 *.db *.dll *.exe

include README.md
include README.zh-TW.md
include CHANGELOG.md
include CHANGELOG.zh-TW.md
include LICENSE
