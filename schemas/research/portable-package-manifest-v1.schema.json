{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CassiaLin/bg3loc/schemas/research/portable-package-manifest-v1.schema.json",
  "title": "B1-02 portable package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "experiment", "sourceLocale", "targetLocale", "requestCount", "sampleCount", "categoryCounts", "pilotSampleFingerprint", "requestPackageFingerprint", "orderingPolicy", "createdWithVersion", "requestIds"],
  "properties": {
    "schemaVersion": {"const": "portable-package-manifest/1"},
    "experiment": {"const": "B1-02 Same-Entity Context Experiment Phase 2A"},
    "sourceLocale": {"const": "English"},
    "targetLocale": {"const": "ChineseTraditional"},
    "requestCount": {"type": "integer", "minimum": 0},
    "sampleCount": {"type": "integer", "minimum": 0},
    "categoryCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_spell", "item", "quest"],
      "properties": {
        "skill_spell": {"type": "integer", "minimum": 0},
        "item": {"type": "integer", "minimum": 0},
        "quest": {"type": "integer", "minimum": 0}
      }
    },
    "pilotSampleFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requestPackageFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "orderingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "packageSalt"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "packageSalt": {"type": "string", "minLength": 1}
      }
    },
    "createdWithVersion": {"type": "string", "minLength": 1},
    "requestIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^req-[0-9]{6}$"}
    }
  }
}
