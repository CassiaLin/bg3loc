{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CassiaLin/bg3loc/schemas/scan.schema.json",
  "title": "BG3Loc Scan Manifest",
  "type": "object",
  "required": ["schemaVersion", "game", "platform", "backend", "locales", "warnings"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "game": {
      "type": "object",
      "required": ["id", "appId", "installPath", "dataPath"],
      "properties": {
        "id": {"const": "bg3"},
        "appId": {"const": 1086940},
        "installPath": {"type": "string", "minLength": 1},
        "dataPath": {"type": "string", "minLength": 1},
        "buildId": {"type": ["string", "null"]},
        "gameVersion": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "platform": {
      "type": "object",
      "required": ["os", "installKind"],
      "properties": {
        "os": {"enum": ["windows", "linux", "macos"]},
        "installKind": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "backend": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["localeId", "packageFile", "packageSha256", "locaEntries", "status"],
        "properties": {
          "localeId": {"type": "string", "minLength": 1},
          "packageFile": {"type": "string", "minLength": 1},
          "packageSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "locaEntries": {"type": "array"},
          "status": {"enum": ["ready", "ambiguous", "unsupported", "error"]}
        },
        "additionalProperties": true
      }
    },
    "warnings": {"type": "array"}
  },
  "additionalProperties": true
}
